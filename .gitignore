# User-specific runtime files
## Environment Files
/.env
/dev/server/nginx/site.conf
/dev/server/nginx/root.conf
/dev/db/config.yml
/dev/db/samples/*-01-structure_to-remove-AI.sql
/dev/db/samples/*-02-structure_AI-removed.sql
/dev/db/samples/*-03-sanitizedPartialUserData.txt
/dev/db/samples/*-04-devUserData.sql
/dev/assets/tiles/**/*.png
/dev/assets/tiles/**/Trials
/.htaccess

# Cached Files / Runtime-updated Files
/ajax/libs
/ajax/static
/cache/*
!/cache/index.html
/tmp

/css.ini
/javascript.ini

## OS Files
.DS_Store
Thumbs.db

# Downloaded dependencies
node_modules
/tiles/*
!/tiles/oot/
!/tiles/alttp/
!/tiles/tmc/
/vendor
/uploads/profile-pictures/*
!/uploads/profile-pictures/index.html
/uploads/profile-banners/*
!/uploads/profile-banners/index.html
/uploads/marker-images/*
!/uploads/marker-images/index.html
/uploads/marker-videos/*
!/uploads/marker-videos/index.html

# Debug Files
/php_errors.log
/phpinfo.php

# Extra Files
## Part of the database migration framework we're using that could be useful, just not right now.
/dev/db/schema.rb
/dev/db/samples/zeldamaps-*
/dev/db/samples/tingle-*
*.sublime-workspace
*.bak

# PHP settings are per server (cPanel's MultiPHP INI Editor writes this): the
# marker video upload limit (ajax/upload_marker_video.php) is set there.
/.user.ini
