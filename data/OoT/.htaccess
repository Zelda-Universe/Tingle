# The OoT pack's JSON (maps, markers, categories, the import report, and the
# extracted game text) is read by PHP (lib/common/oot_pack.php) and reaches
# the site only through ajax.php. The raw files are never served directly.
# Icons, previews and icons.css in this folder stay public.
<FilesMatch "\.json$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
